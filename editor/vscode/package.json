{
  "name": "cadstudio",
  "displayName": "CADStudio",
  "description": "Open the CADStudio GUI in a VS Code webview.",
  "version": "0.0.1",
  "publisher": "danillogical",
  "private": true,
  "engines": {
    "vscode": "^1.89.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:cadstudio.openGui",
    "onUri",
    "onWebviewPanel:cadstudio.gui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cadstudio.openGui",
        "title": "CADStudio: Open GUI"
      }
    ],
    "taskDefinitions": [
      {
        "type": "cadstudio",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "serve"
            ],
            "description": "The CADStudio task to run; `serve` runs `cad gui serve`."
          }
        }
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.89.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
